#!/bin/bash

# Abort if anything fails
set -e

# Parse command line arguments
NO_CACHE=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --no-cache)
    NO_CACHE=1
    shift
    ;;
  --no-boot-offer)
    NO_BOOT_OFFER=1
    shift
    ;;
  --local-source)
    LOCAL_SOURCE=1
    OMARCHY_MIRROR=edge
    shift
    ;;
  --dev)
    OMARCHY_INSTALLER_REF=dev
    OMARCHY_MIRROR=edge
    shift
    ;;
  --rc)
    OMARCHY_MIRROR=rc
    OMARCHY_INSTALLER_REF=rc
    shift
    ;;
  --custom-kernel)
    USE_CUSTOM_KERNEL=1
    shift
    ;;
  --build-kernel)
    USE_CUSTOM_KERNEL=1
    BUILD_KERNEL=1
    shift
    ;;
  --no-t2)
    OMARCHY_NO_T2=1
    shift
    ;;
  *)
    echo "Unknown option: $1"
    echo "Usage: $0 [--no-cache] [--no-boot-offer] [--local-source] [--dev] [--rc] [--custom-kernel] [--build-kernel] [--no-t2]"
    exit 1
    ;;
  esac
done

# Ensure we have the submodule checked out
git submodule update --init --recursive --jobs=8

# Prepare build repo
BUILD_SCRIPT="builder/build-iso.sh"
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
BUILD_RELEASE_PATH="$BUILD_ROOT/release"
mkdir -p "$BUILD_RELEASE_PATH"

OMARCHY_INSTALLER_REPO="${OMARCHY_INSTALLER_REPO:-basecamp/omarchy}"
OMARCHY_INSTALLER_REF="${OMARCHY_INSTALLER_REF:-master}"
OMARCHY_MIRROR="${OMARCHY_MIRROR:-stable}"
LINUX_KERNEL_BRANCH="${LINUX_KERNEL_BRANCH:-v7.0-rc4}"

DOCKER_ARGS=(
  --rm
  --privileged
  -e "OMARCHY_INSTALLER_REPO=$OMARCHY_INSTALLER_REPO"
  -e "OMARCHY_INSTALLER_REF=$OMARCHY_INSTALLER_REF"
  -e "OMARCHY_MIRROR=$OMARCHY_MIRROR"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -v "$BUILD_RELEASE_PATH/:/out/"
  -v "$BUILD_ROOT/$BUILD_SCRIPT:/$BUILD_SCRIPT:ro"
  -v "$BUILD_ROOT/archiso:/archiso:ro"
  -v "$BUILD_ROOT/builder:/builder:ro"
  -v "$BUILD_ROOT/configs:/configs:ro"
)

# Use local source of Omarchy from $OMARCHY_PATH instead of git checkout
if [[ -n "${LOCAL_SOURCE-}" ]]; then
  DOCKER_ARGS+=(-v "$OMARCHY_PATH:/omarchy:ro")
fi

# Mount a pre-built custom kernel package if --custom-kernel or --build-kernel was passed
if [[ -n "${USE_CUSTOM_KERNEL-}" ]]; then
  KERNEL_PKG_DIR="$BUILD_ROOT/release/kernels"
  KERNEL_PKG=$(ls "$KERNEL_PKG_DIR"/linux-mainline-[0-9]*.pkg.tar.zst 2>/dev/null | head -n1)

  if [[ -z "$KERNEL_PKG" ]]; then
    if [[ -n "${BUILD_KERNEL-}" ]]; then
      echo "No cached kernel package found. Building kernel from source first..."
      echo
      LINUX_KERNEL_BRANCH="$LINUX_KERNEL_BRANCH" "$BUILD_ROOT/bin/omarchy-iso-build-kernel"
      KERNEL_PKG=$(ls "$KERNEL_PKG_DIR"/linux-mainline-[0-9]*.pkg.tar.zst 2>/dev/null | head -n1)
    else
      echo "Error: Custom kernel package not found in release/kernels/"
      echo
      echo "Build it first with:"
      echo "  LINUX_KERNEL_BRANCH=$LINUX_KERNEL_BRANCH ./bin/omarchy-iso-build-kernel"
      echo
      echo "Or use --build-kernel to build the kernel and ISO in one step."
      exit 1
    fi
  fi

  DOCKER_ARGS+=(
    -e "USE_CUSTOM_KERNEL=1"
    -e "LINUX_KERNEL_BRANCH=$LINUX_KERNEL_BRANCH"
    -v "$KERNEL_PKG_DIR:/custom-kernel:ro"
  )
fi

# Skip T2 kernel if --no-t2 was passed
if [[ -n "${OMARCHY_NO_T2-}" ]]; then
  DOCKER_ARGS+=(-e "OMARCHY_NO_T2=1")
fi

# Use local pacman cache if you already have one on host to speed up repeat runs
if [ -d "/var/cache/pacman/pkg" ]; then
  DOCKER_ARGS+=(-v "/var/cache/pacman/pkg:/var/cache/pacman/pkg")
fi

# Mount the build cache directory where packages are downloaded
if [[ -z "$NO_CACHE" ]]; then
  # using a dated dir on the host to refresh daily if building multiple times
  BUILD_DATE=$(date +%Y-%m-%d)
  OFFLINE_REPO_BUILD_CACHE_DIR="$HOME/.cache/omarchy/iso_${BUILD_DATE}/airootfs/var/cache/omarchy"
  mkdir -p "$OFFLINE_REPO_BUILD_CACHE_DIR"
  # Mount to /var/cache/airootfs/var/cache/omarchy since that's where repo packages go in the ISO
  DOCKER_ARGS+=(-v "$OFFLINE_REPO_BUILD_CACHE_DIR:/var/cache/airootfs/var/cache/omarchy")
fi

# Run the builder with assembled args
docker run "${DOCKER_ARGS[@]}" archlinux/archlinux:latest /$BUILD_SCRIPT

# Move as install ref, appending kernel branch when a custom kernel was used
latest_iso=$(\ls -t "$BUILD_RELEASE_PATH"/*.iso | head -n1)
iso_ref="${latest_iso%.*}-$OMARCHY_INSTALLER_REF"
if [[ -n "${USE_CUSTOM_KERNEL-}" ]]; then
  KERNEL_SAFE_BRANCH="${LINUX_KERNEL_BRANCH//\//-}"
  iso_ref="${iso_ref}-linux-mainline-${KERNEL_SAFE_BRANCH}"
fi
iso_ref="${iso_ref}.iso"
mv -f "$latest_iso" "$iso_ref"

# Offer to boot the new build
if [[ -z "$NO_BOOT_OFFER" ]]; then
  echo
  gum confirm "Boot $iso_ref?" && omarchy-iso-boot "$iso_ref"
fi
